<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_currency_rate" model="ir.ui.view">
        <field name="name">res.config.settings.currency.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Currency Rate Manager" name="currency_rate_manager">

                    <block title="Currency Rate Settings">

                        <setting string="Provider">
                            <field name="currency_provider"/>
                        </setting>

                        <setting string="Automatic Update">
                            <field name="currency_auto_update"/>
                        </setting>

                        <setting string="Update Interval">
                            <field name="currency_update_interval"/>
                        </setting>

                        <setting string="Connection">

                            <button
                                name="action_test_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-primary"/>

                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>
