<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_currency_form_rate_manager" model="ir.ui.view">
        <field name="name">res.currency.form.rate.manager</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group" position="inside">

                <group string="Exchange Rate Manager">

                    <field name="current_rate" readonly="1"/>

                    <field name="manual_rate"/>

                    <field name="last_update" readonly="1"/>

                    <field name="updated_by" readonly="1"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>
