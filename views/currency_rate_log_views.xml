<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_currency_rate_log_tree" model="ir.ui.view">
        <field name="name">currency.rate.log.tree</field>
        <field name="model">currency.rate.log</field>
        <field name="arch" type="xml">

            <list string="Currency Update Logs">

                <field name="create_date"/>

                <field name="provider"/>

                <field name="status"
                       widget="badge"/>

                <field name="company_id"/>

                <field name="message"/>

            </list>

        </field>
    </record>

    <record id="view_currency_rate_log_form" model="ir.ui.view">
        <field name="name">currency.rate.log.form</field>
        <field name="model">currency.rate.log</field>
        <field name="arch" type="xml">

            <form string="Currency Update Log">

                <sheet>

                    <group>

                        <field name="create_date" readonly="1"/>
                        <field name="provider" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="company_id" readonly="1"/>

                    </group>

                    <group>

                        <field name="message" readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <record id="action_currency_rate_log" model="ir.actions.act_window">
        <field name="name">Currency Update Logs</field>
        <field name="res_model">currency.rate.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
