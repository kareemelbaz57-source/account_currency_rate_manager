<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_currency_dashboard_form" model="ir.ui.view">
        <field name="name">currency.dashboard.form</field>
        <field name="model">currency.dashboard</field>
        <field name="arch" type="xml">
            <form string="Currency Dashboard" create="0" edit="0">

                <sheet>

                    <group>

                        <group>
                            <field name="currency_count" readonly="1"/>
                            <field name="history_count" readonly="1"/>
                        </group>

                        <group>
                            <field name="provider" readonly="1"/>
                            <field name="last_update" readonly="1"/>
                        </group>

                    </group>

                    <footer>

                        <button
                            name="action_update_now"
                            type="object"
                            string="Update Now"
                            class="btn-primary"
                            icon="fa-refresh"/>

                    </footer>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_currency_dashboard" model="ir.actions.act_window">
        <field name="name">Currency Dashboard</field>
        <field name="res_model">currency.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
